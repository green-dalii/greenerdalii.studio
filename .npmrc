# astro-icon@1.1.5 通过 @iconify/utils/lib/loader/fs 加载 iconify collections，
# 后者依赖 mlly、@antfu/install-pkg、@antfu/utils、kolorist、local-pkg 等。
# 这些包在 astro-icon 这条链路下都不是直依赖，pnpm 默认 strict 布局下
# 间接依赖的间接依赖无法被解析。最稳妥的做法是 shamefully-hoist：
# 让 pnpm 把所有依赖都暴露到顶层 node_modules，等同于 npm/yarn 的扁平布局。
# 副作用：失去严格依赖检查；本项目体量小，权衡收益大于成本。
shamefully-hoist=true

# 同时保留之前的精准 hoist（无害）：tailwindcss 系列、@iconify 系列。
public-hoist-pattern[]=*tailwindcss*
public-hoist-pattern[]=*@tailwindcss/*
public-hoist-pattern[]=tailwindcss-fluid-type
public-hoist-pattern[]=*@iconify*