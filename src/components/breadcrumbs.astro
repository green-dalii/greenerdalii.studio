---
const { urlList, isTitle = "NoTitle" } = Astro.props;
---

<div class="sm:pb-30 mx-auto max-w-7xl px-6 pt-0 sm:px-2">
    <div class="container mx-auto px-0 sm:px-5 sm:pb-24">
        <nav aria-label="面包屑 | Breadcrumb">
            <div class="breadcrumbs text-sm">
                <ul>
                    <li><a href="/">Home</a></li>
                    {
                        urlList.map((url: string, index: number) => (
                            <li>
                                {index === urlList.length - 1 ? (
                                    isTitle !== "NoTitle" ? (
                                        <span aria-current="page">{isTitle}</span>
                                    ) : (
                                        <span aria-current="page">
                                            {url.charAt(0).toUpperCase() + url.slice(1)}
                                        </span>
                                    )
                                ) : (
                                    <a href={`/${url}`}>
                                        {url.charAt(0).toUpperCase() + url.slice(1)}
                                    </a>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </nav>
    </div>
</div>
