---
// import "@fontsource/inter/variable.css";
import "../styles/index.css";
import { getLangFromUrl } from "~/i18n/utils";

export interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title: propTitle,
  description: propDescription,
  ogType = "website",
  ogImage,
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;
const { generator, site } = Astro;

// Canonical: use current request URL (stripped trailing slash for consistency),
// fall back to site origin for build-time contexts.
const rawPath = Astro.url?.pathname ?? "/";
const canonicalPath = rawPath.length > 1 ? rawPath.replace(/\/$/, "") : rawPath;
const canonicalUrl = new URL(canonicalPath, site).toString().replace(/\/$/, "") + "/";

const fallbackOg = new URL("social.svg", site);
const ogImageUrl = ogImage ? new URL(ogImage, site).toString() : fallbackOg.toString();

const lang = getLangFromUrl(Astro.url);
const ogLocale = lang === "en" ? "en_US" : "zh_CN";
const ogLocaleAlternate = lang === "en" ? "zh_CN" : "en_US";

const defaultDescription =
  "Greener-Dalii is an up-and-coming branding studio. We try to bring brand design to everyone.";
const description = propDescription || defaultDescription;
// Append the studio suffix only when the page title doesn't already mention
// Greener-Dalii, otherwise we get double-branded titles like
// "Greener-Dalii | Greener-Dalii Studio".
const alreadyBranded = propTitle
  ? /greener[-\s]?dalii/i.test(propTitle)
  : false;
const title = propTitle
  ? alreadyBranded
    ? propTitle
    : `${propTitle} | Greener-Dalii Studio`
  : "格润达理工作室 | Greener-Dalii Studio";
---

<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>
<meta name="generator" content={generator} />

<!-- Title & Description -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- hreflang for bilingual SEO -->
<link rel="alternate" hreflang="x-default" href={new URL("/", site).toString()} />
<link
  rel="alternate"
  hreflang="zh-CN"
  href={new URL("/", site).toString()}
/>
<link
  rel="alternate"
  hreflang="en"
  href={new URL("/en/", site).toString()}
/>

{noindex && <meta name="robots" content="noindex,nofollow" />}

<!-- Open Graph -->
<meta property="og:title" content={propTitle ?? "Greener-Dalii Studio"} />
<meta property="og:type" content={ogType} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Greener-Dalii Studio" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={propTitle ?? "Greener-Dalii Studio"} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{
  publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}
{author && <meta property="article:author" content={author} />}

<!-- Theme bootstrap -->
<script is:inline>
  const themeSaved = localStorage.getItem("theme");

  if (themeSaved) {
    document.documentElement.dataset.theme = themeSaved;
  } else {
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)"
    ).matches;
    document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
  }

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (event) => {
      if (!localStorage.getItem("theme")) {
        document.documentElement.dataset.theme = event.matches
          ? "dark"
          : "light";
      }
    });
</script>
