---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/breadcrumbs.astro";
import ContentSection from "~/components/content-section.astro";
import WorkCard from "~/components/work-card.astro";
import { getShowcase } from "../../data/work";
import { breadcrumbLd, creativeWorkLd } from "~/lib/jsonld";
import { SITE_URL } from "~/lib/site-config";

const sites = await getShowcase();
const urlList = Astro.url.pathname.split("/").filter(Boolean);
const pageUrl = `${SITE_URL}/work`;

// Map portfolio entries to CreativeWork / VisualArtwork entities so search
// engines and AI assistants can index each project individually.
const workLdEntities = sites
  .filter((s) => s.isDisplayed !== false)
  .map((site) => {
    const slug = site.url.replace(/^\/work\//, "");
    return creativeWorkLd({
      slug,
      titleZh: site.title,
      titleEn: site.titleEN,
      description: `${site.industry} · ${site.client} · ${site.date}`,
      client: site.client,
      industry: site.industry,
      pubDate: site.date,
    });
  });
---

<BaseLayout
  title="品牌案例"
  description="格润达理工作室品牌设计案例展示,涵盖品牌策略、VI 设计、包装设计、IP 形象设计、网站设计等领域。客户包括教育、工业、农业、AI 社区等行业。"
  ogType="website"
  jsonLd={[
    breadcrumbLd([
      { name: "Home", url: SITE_URL + "/" },
      { name: "Works", url: pageUrl },
    ]),
    ...workLdEntities,
  ]}
>
  <div class="mt-20 sm:mt-10 sm:pb-32 sm:pt-10">
    <Breadcrumbs urlList={urlList} />
    <ContentSection title="合作项目" subtitle="Our Works" id="work">
      <Fragment slot="description">
        以下商业作品是我们的创意宣言，每一件作品都是商业策略、艺术美学与理性思维交织的结晶。在此板块，我们将展现如何通过独特的设计理念与卓越的设计实践，赋能品牌，使之在市场中脱颖而出。
      </Fragment>
      <Fragment slot="description-below">
        The portfolio at Greener-Dalii Studio is our creative manifesto, where
        each piece intertwines business acumen, artistic expression, and
        rational thinking. In this section, we reveal how we fuse these elements
        to empower brands, making them stand out in today's marketplace.
      </Fragment>
      <Fragment slot="content">
        <div class="flex scroll-mt-24 flex-col items-center gap-4 space-y-8">
          <div class="w-full max-w-7xl space-y-2">
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
              {sites.map((site) => <WorkCard site={site} />)}
            </div>
          </div>
        </div>
      </Fragment>
    </ContentSection>
  </div>
</BaseLayout>
