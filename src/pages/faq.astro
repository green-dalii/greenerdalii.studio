---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentSection from "~/components/content-section.astro";
import Breadcrumbs from "~/components/breadcrumbs.astro";
import Btn from "~/components/button.astro";
import { breadcrumbLd, faqPageLd } from "~/lib/jsonld";
import { SITE_URL } from "~/lib/site-config";

const urlList = Astro.url.pathname.split("/").filter(Boolean);
const pageUrl = `${SITE_URL}/faq`;

// Single source of truth for FAQ pairs: rendered as content here and as
// FAQPage structured data for Rich Result eligibility.
const faqs = [
  {
    question: "我能提出多少设计需求都可以吗?",
    answer:
      "没有限制。在订阅期内,您可以根据实际需求随时将任意数量的设计需求加入工作队列,我们会按队列顺序一一完成。",
    questionEn:
      "Can I submit as many design requests as I want?",
    answerEn:
      "Absolutely, no limits. Add any number of design tasks to your queue as needed, and we'll tackle them one by one.",
  },
  {
    question: "我的设计需求能够多快交付?",
    answer:
      "一般的设计需求我们会在两个工作日内完成。Banner 1–3 天,包装 2–5 天,海报 2–7 天,单页网页 5–10 天,Logo 与 IP 设计 5–20 天,完整 VI 设计 10–60 天。",
    questionEn: "How promptly can I expect my designs to be delivered?",
    answerEn:
      "Standard requests are fulfilled within two business days. Banners 1–3 days, packaging 2–5 days, posters 2–7 days, single-page websites 5–10 days, logos and IP design 5–20 days, full VI systems 10–60 days.",
  },
  {
    question: "如果对设计方案不太满意怎么办?",
    answer: "我们会一直修改设计,直到您 100% 满意为止。订阅制下无修改次数上限。",
    questionEn: "What if I don't like the design?",
    answerEn:
      "We'll continue to revise the design until you're 100% satisfied. There is no cap on revisions under the subscription plan.",
  },
  {
    question: "订阅制暂停功能怎么使用?",
    answer:
      "暂停后,您的剩余订阅时长会被保留,新需求进入时再恢复计费。比一次性退订更灵活。",
    questionEn: "How does the pause feature work in subscription?",
    answerEn:
      "Pausing preserves your remaining subscription length so you can resume later without losing paid time.",
  },
  {
    question: "如果我只有一个请求项目怎么办?",
    answer:
      "您可以采用按项目付费制,或者订阅完成后使用暂停功能,避免为不需要的时长付费。",
    questionEn: "What if I only have a single request?",
    answerEn:
      "Use our pay-per-project model, or subscribe and pause after delivery so you only pay for active time.",
  },
  {
    question: "如果我不喜欢这项服务,可以退款吗?",
    answer:
      "考虑到设计投入,如果当月已有执行项目,订阅费无法退还,但您可以随时取消下个月的订阅。",
    questionEn: "Are there any refunds if I don't like the service?",
    answerEn:
      "Because design work is labor-intensive, refunds are not available once work has started in a given month. You may cancel future months at any time.",
  },
  {
    question: "你们如何管理项目?我们如何追踪任务进度?",
    answer:
      "我们基于飞书搭建了一套业务管理系统,您可以实时查看任务队列、进度情况和订阅剩余时长。",
    questionEn: "How do you manage projects and track progress?",
    answerEn:
      "We run on Feishu, giving you a real-time view of task queues, progress and remaining subscription time.",
  },
  {
    question: "哪些设计类型适合订阅制?",
    answer:
      "订阅制最适合需要持续输出设计素材的团队:日常 Banner、海报、社交媒体配图、新品包装迭代、UI 改版、品牌增量物料等。一次性大项目(如全新 VI)更适合按项目付费制。",
    questionEn: "Which design types suit the subscription plan?",
    answerEn:
      "Subscriptions fit teams needing continuous output — daily banners, posters, social assets, packaging iterations, UI tweaks, brand extensions. One-off large projects (e.g. a brand-new VI) are better suited to the pay-per-project model.",
  },
];

// FAQPage schema needs Chinese-only question/answer pairs (one main language
// per page); the bilingual body content is still rendered below.
const faqLd = faqPageLd(
  faqs.map((f) => ({ question: f.question, answer: f.answer })),
  pageUrl
);
---

<BaseLayout
  title="常见问题"
  description="关于格润达理工作室设计订阅制、品牌设计服务流程、交付周期、暂停与退款机制的常见问题解答,帮助您选择合适的品牌设计合作模式。"
  ogType="website"
  jsonLd={[breadcrumbLd([
    { name: "Home", url: SITE_URL + "/" },
    { name: "FAQ", url: pageUrl },
  ]), faqLd]}
>
  <div class="mt-20 sm:mt-10 sm:pb-32 sm:pt-10 bg-[--color-background]">
    <Breadcrumbs urlList={urlList} />
    <ContentSection title="常见问题" subtitle="FAQs" id="faq">
      <Fragment slot="description">
        关于设计订阅制、服务流程、交付周期与合作的常见疑问,中英对照整理。
      </Fragment>
      <Fragment slot="description-below">
        Frequently asked questions about our design subscription, workflow,
        delivery timelines and collaboration, presented in Chinese and English.
      </Fragment>
      <Fragment slot="content">
        <div class="mx-auto max-w-3xl">
          <div class="grid gap-y-2">
            {
              faqs.map((f) => (
                <details class="collapse collapse-arrow bg-[--color-background-offset]">
                  <summary class="collapse-title font-medium text-base cursor-pointer">
                    {f.question}
                    <h4 class="text-xs">{f.questionEn}</h4>
                  </summary>
                  <div class="collapse-content">
                    <p class="text-[--color-text-offset] text-sm">{f.answer}</p>
                    <p class="pt-2 text-[--color-text-offset] text-xs">{f.answerEn}</p>
                  </div>
                </details>
              ))
            }
          </div>
          <div class="mt-12 flex flex-row flex-wrap items-center justify-between gap-4">
            <div class="flex flex-col">
              <div class="font-medium text-lg">还有其他问题? 🙋‍♂️</div>
              <div class="font-light text-sm">Other questions?</div>
            </div>
            <Btn
              btnText="联系我们 👋"
              btnAltText="Contact Us 👋"
              url="/contact"
              cls="px-6"
            />
          </div>
          <p class="mt-8 text-xs text-[--color-text-offset]">
            想了解完整的服务菜单?请访问
            <a href="/service" class="underline">服务页</a>。
            For the full service menu, visit the
            <a href="/service" class="underline">services page</a>.
          </p>
        </div>
      </Fragment>
    </ContentSection>
  </div>
</BaseLayout>
