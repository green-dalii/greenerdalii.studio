---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentSection from "~/components/content-section.astro";
import BlogCard from "~/components/blog-card.astro";
import Btn from "~/components/button.astro";
import { getCollection } from "astro:content";
import { breadcrumbLd, articleLd } from "~/lib/jsonld";
import { SITE_URL } from "~/lib/site-config";

export async function getStaticPaths() {
  // const allPosts = await Astro.glob("../*.md");
  const allPosts = await getCollection("insight");
  const uniqueTags = [
    ...new Set(allPosts.map((post: any) => post.data.tags).flat()),
  ];
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post: any) =>
      post.data.tags.includes(tag)
    );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const pageUrl = `${SITE_URL}/insight/tags/${tag}`;

const articleLdEntities = posts.map((post: any) =>
  articleLd({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    author: post.data.author,
    occupation: post.data.occupation,
    pubDate: post.data.pubDate.toISOString(),
    tags: post.data.tags,
  })
);
---

<BaseLayout
  title={`${tag} - 品牌设计文章`}
  description={`标签「${tag}」下的所有品牌设计文章,来自格润达理工作室品牌洞察专栏。`}
  ogType="website"
  jsonLd={[
    breadcrumbLd([
      { name: "Home", url: SITE_URL + "/" },
      { name: "Insights", url: `${SITE_URL}/insight` },
      { name: "Tags", url: `${SITE_URL}/insight/tags` },
      { name: tag as string, url: pageUrl },
    ]),
    ...articleLdEntities,
  ]}
>
  <div class="mt-20 sm:mt-10 sm:pb-32 sm:pt-10">
    <ContentSection title="品牌洞察" subtitle="Our Insights" id="insight">
      <Fragment slot="description">
        <p>标签为: {tag} 的所有文章</p>
      </Fragment>
      <Fragment slot="content">
        <BlogCard allPosts={posts} />
        <div class="mt-20 text-center">
          <Btn btnText="← Go Back" btnAltText="← 返回" url="/insight" cls="" />
        </div>
      </Fragment>
    </ContentSection>
  </div>
</BaseLayout>
