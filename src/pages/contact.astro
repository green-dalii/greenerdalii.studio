---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentSection from "~/components/content-section.astro";
import Breadcrumbs from "~/components/breadcrumbs.astro";
import { Icon } from "astro-icon/components";
import { breadcrumbLd } from "~/lib/jsonld";
import { SITE_URL } from "~/lib/site-config";

const urlList = Astro.url.pathname.split("/").filter(Boolean);
const pageUrl = `${SITE_URL}/contact`;
---

<BaseLayout
  title="联系我们"
  description="通过邮件 hi@greenerdalii.top、微信、飞书、Behance、Instagram、Twitter/X、ZCOOL、小红书、微信公众号等多种渠道联系格润达理工作室,获取品牌设计咨询与项目报价。"
  ogType="website"
  jsonLd={breadcrumbLd([
    { name: "Home", url: SITE_URL + "/" },
    { name: "Contact", url: pageUrl },
  ])}
>
  <div class="mt-20 sm:mt-10 sm:pb-32 sm:pt-10 bg-[--color-background]">
    <Breadcrumbs urlList={urlList} />
    <ContentSection
      title="期待一起合作👋"
      subtitle="Let's Work Together"
      id="about"
    >
      <Fragment slot="description">
        如果您正在寻求与众不同的品牌设计方案，欢迎随时通过以下方式与我们取得联系。无论您有任何关于品牌设计的需求或问题，我们都乐意倾听并为您提供专业的咨询服务。您如果想得到最快的响应，可以随时在下方与我们的AI智能助手交谈咨询。
      </Fragment>
      <Fragment slot="description-below">
        If you're seeking unique branding solutions, feel free to reach out to
        us anytime. Whatever your requirements or queries about branding design,
        we are eager to listen and provide professional consultation services.
        You can always talk to our AI smart assistant below for advice if you
        want the fastest response.
      </Fragment>
      <Fragment slot="content">
        <div class="relative grid grid-cols-5">
          <div
            class="absolute col-span-2 hidden md:-top-64 md:right-2/3 md:block"
          >
            <Icon
              name="service/SelfieDoodle"
              class="h-96 w-96 sm:h-[40rem] sm:w-[40rem]"
              aria-hidden="true"
            />
          </div>
          <div class="col-span-full md:col-span-3 md:col-start-3">
            <div class="grid gap-y-2">
              <!-- <div
                class="collapse collapse-arrow bg-[--color-background-offset]"
              >
                <input type="radio" name="my-accordion-3" />
                <div class="collapse-title font-medium text-lg">
                  🦄 智能助手
                </div>
                <div class="collapse-content">
                  <div class="flex flex-col gap-4">
                    <Ai />
                    <p class="text-xs">⚠️ 注：所有回答均为AI生成，可能会犯错，请核查重要信息，如有疑问请通过以下方式直接联系我们。</p>
                  </div>
                </div>
              </div> -->
              <div
                class="collapse collapse-arrow bg-[--color-background-offset]"
              >
                <input type="radio" name="my-accordion-3" />
                <div class="collapse-title font-medium text-lg">
                  Contact | 联系方式
                </div>
                <div class="collapse-content">
                  <div class="flex flex-col gap-4">
                    <!-- row 1 -->
                    <div class="flex flex-wrap gap-x-2">
                      <div class="flex flex-wrap items-center gap-x-2">
                        <Icon name="mdi:alternate-email" class="text-lg" aria-hidden="true" />
                        <div class="text-sm">Email:</div>
                      </div>
                      <a href="mailto:hi@greenerdalii.top" class="underline text-sm">
                        hi@greenerdalii.top
                      </a>
                    </div>
                    <!-- row 2 -->
                    <div class="flex flex-row flex-wrap items-center gap-8">
                      <div class="flex flex-col items-center">
                        <Icon
                          name="contact_wechat"
                          class="h-20 w-20 text-[--color-text-offset]"
                          aria-label="WeChat QR code"
                        />
                        <div class="text-[--color-text-offset] text-xs">微信扫一扫</div>
                      </div>
                      <div class="flex flex-col items-center">
                        <Icon
                          name="feishu"
                          class="h-20 w-20 text-[--color-text-offset]"
                          aria-label="Feishu QR code"
                        />
                        <div class="text-[--color-text-offset] text-xs">飞书扫一扫</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="collapse collapse-arrow bg-[--color-background-offset]"
              >
                <input type="radio" name="my-accordion-3" />
                <div class="collapse-title font-medium text-lg">
                  Social Media | 社交媒体
                </div>
                <div class="collapse-content">
                  <div class="flex flex-row justify-between">
                    <ul>
                      <li>
                        <a
                          href="https://www.behance.net/greenerdalii"
                          class="text-xs after:content-['_↗']">Behance</a
                        >
                      </li>
                      <li>
                        <a
                          href="https://www.instagram.com/greenerdalii/"
                          class="text-xs after:content-['_↗']">Instagram</a
                        >
                      </li>
                      <li>
                        <a
                          href="https://twitter.com/greenerdalii"
                          class="text-xs after:content-['_↗']">X (Twitter)</a
                        >
                      </li>
                      <li>
                        <a
                          href="https://greenerdalii.zcool.com.cn/"
                          class="text-xs after:content-['_↗']">ZCOOL</a
                        >
                      </li>
                      <li>
                        <div class="group">
                          <div class="cursor-e-resize text-xs">微信公众号</div>
                          <Icon
                            name="wechatgzh"
                            class="invisible absolute inset-x-0 bottom-0 z-10 mb-12 ml-32 h-28 w-28 text-[--color-text-offset] opacity-0 transition-all duration-300 ease-in-out group-hover:visible group-hover:opacity-100 group-hover:ease-in-out"
                            aria-hidden="true"
                          />
                        </div>
                      </li>
                      <li>
                        <div class="group">
                          <div class="cursor-e-resize text-xs">小红书</div>
                          <Icon
                            name="xiaohongshu2"
                            class="invisible absolute inset-x-0 bottom-0 z-10 mb-6 ml-32 h-28 w-28 text-[--color-text-offset] opacity-0 transition-all duration-300 ease-in-out group-hover:visible group-hover:opacity-100 group-hover:ease-in-out"
                            aria-hidden="true"
                          />
                        </div>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              <div
                class="collapse collapse-arrow bg-[--color-background-offset]"
              >
                <input type="radio" name="my-accordion-3" />
                <div class="collapse-title font-medium text-lg">
                  Meet Us | 来面基
                </div>
                <div class="collapse-content">
                  <div class="flex flex-col">
                    <div class="flex flex-wrap items-center gap-x-2">
                      <Icon name="mdi:location" aria-hidden="true" />
                      <div class="text-sm">Location:</div>
                    </div>
                    <div class="flex flex-row justify-between gap-8">
                      <div class="flex flex-col">
                        <a
                          href="https://surl.amap.com/1h8W1gK156v6"
                          class="text-xs"
                        >
                          Xi'an, Shaanxi Province, China
                        </a>
                        <a
                          href="https://surl.amap.com/1h8W1gK156v6"
                          class="text-xs">陕西省西安市</a
                        >
                      </div>
                      <Icon
                        name="map"
                        class="shrink text-[--color-text-offset] text-9xl"
                        aria-hidden="true"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Fragment>
    </ContentSection>
  </div>
</BaseLayout>
