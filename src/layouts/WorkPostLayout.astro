---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "~/components/breadcrumbs.astro";
import "@fontsource/inter/variable.css";
import { Image } from "astro:assets";
import ContentSection from "../components/content-section.astro";
import Btn from "../components/button.astro";
import Citation from "~/components/citation.astro";
import { breadcrumbLd, creativeWorkLd } from "~/lib/jsonld";
import { SITE_URL } from "~/lib/site-config";
// import { Debug } from 'astro:components';
const { frontmatter } = Astro.props;
const urlList = Astro.url.pathname.split("/").filter(Boolean);
const allMedias = import.meta.glob('../data/work/*/*.{jpeg,jpg,png,gif,mp4}', { eager: true });
const medias = Object.values(allMedias).reduce((acc: any[], media: any) => {
  const mediaPath = typeof media.default === 'string' ? media.default : media.default.src;
  if (mediaPath.includes(`${frontmatter.path}`)) {
    acc.push(media);
  }
  return acc;
}, []);

const videoProps = {
  playsInline: true,
  autoPlay: true,
  muted: true,
  loop: true
}

// JSON-LD: VisualArtwork entity + BreadcrumbList. Each project becomes a
// citable creative-work node in schema.org, helping SEO + GEO pipelines
// surface individual works.
const slug = urlList[urlList.length - 1] ?? "";
const pageUrl = `${SITE_URL}/work/${slug}`;
const heroImageUrl = medias.find((m: any) => {
  const src = typeof m.default === "string" ? m.default : m.default.src;
  return /\.(jpe?g|png|gif)$/i.test(src);
})
  ? new URL(
      typeof medias.find((m: any) => /\.(jpe?g|png|gif)$/i.test(typeof m.default === "string" ? m.default : m.default.src)).default === "string"
        ? medias.find((m: any) => /\.(jpe?g|png|gif)$/i.test(typeof m.default === "string" ? m.default : m.default.src)).default
        : medias.find((m: any) => /\.(jpe?g|png|gif)$/i.test(typeof m.default === "string" ? m.default : m.default.src)).default.src,
      SITE_URL
    ).toString()
  : undefined;

const workLd = creativeWorkLd({
  slug,
  titleZh: frontmatter.title,
  titleEn: frontmatter.enTitle ?? frontmatter.title,
  description: frontmatter.description ?? "",
  client: frontmatter.author,
  industry: frontmatter.industry ?? (frontmatter.tags ?? []).join(", "),
  pubDate: frontmatter.pubDate,
  imageUrl: heroImageUrl,
});
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType="article"
  ogImage={heroImageUrl}
  author={frontmatter.author}
  publishedTime={new Date(frontmatter.pubDate).toISOString()}
  jsonLd={[
    breadcrumbLd([
      { name: "Home", url: SITE_URL + "/" },
      { name: "Works", url: `${SITE_URL}/work` },
      { name: frontmatter.title, url: pageUrl },
    ]),
    workLd,
  ]}
>
  <div class="mt-20 sm:pb-32 bg-[--color-background]">
    <Breadcrumbs urlList={urlList} isTitle={frontmatter.title}/>
    <ContentSection
      title={frontmatter.title}
      subtitle={frontmatter.enTitle}
      id="project"
    >
      <Fragment slot="description">
        {frontmatter.description}
      </Fragment>
      <Fragment slot="description-below">
        {frontmatter.enDescription}
        {frontmatter.link && (
          <div class="mt-4">
            <a href={frontmatter.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-xs font-medium hover:text-primary hover:underline">
              <span>品牌方官网 | Reference Link</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        )}
      </Fragment>
      <Fragment slot="content">
        <div class="flex scroll-mt-24 flex-col items-center gap-4 space-y-8">
          <div class="w-full max-w-7xl space-y-2">
            <div>
              {medias.map((media: any) => {
                const ext = typeof media.default === 'string' ? media.default.split('.').pop() : media.default.format;
                let mediaComponent;

                if (['jpg', 'jpeg', 'png', 'gif'].includes(ext)) {
                  mediaComponent = (
                    <Image
                      src={media.default}
                      widths={[1000, 2000]}
                      sizes={`(max-width: 768px) 1000px, 2000px`}
                      alt={media.default.src.split('/').pop()}
                      quality="high"
                    />
                  );
                } else if (ext === 'mp4') {
                  mediaComponent = (
                    <video class="w-full" {...videoProps} aria-label={`${frontmatter.title} - ${frontmatter.enTitle ?? ""} video`}>
                      <source src={typeof media.default === 'string' ? media.default : media.default.src} type="video/mp4" />
                    </video>
                  );
                }

                return mediaComponent;
              })}
            </div>
          </div>
        </div>
        <div class="mt-40 text-center">
          <Btn btnText="← Go Back" btnAltText="← 返回" url="/work" cls=""></Btn>
        </div>
      </Fragment>
    </ContentSection>
  </div>
  <Citation
    kind="work"
    author={frontmatter.author}
    title={frontmatter.title}
    titleEn={frontmatter.enTitle}
    pubDate={frontmatter.pubDate}
    pageUrl={pageUrl}
  />
</BaseLayout>

