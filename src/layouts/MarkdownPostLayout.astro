---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "~/components/breadcrumbs.astro";
// import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { articleLd, breadcrumbLd } from "~/lib/jsonld";
import { SITE_URL } from "~/lib/site-config";
// const { Content, headings } = await entry.render();
const { frontmatter, relatedPosts } = Astro.props;
// const allPosts = await Astro.glob("../pages/insight/*.md");
const images: Record<string, { default: ImageMetadata }> = import.meta.glob(
  "/src/data/insight/*/*.{jpeg,jpg,png,gif}",
  { eager: true }
);
// import { Debug } from "astro:components";
const urlList = Astro.url.pathname.split("/").filter(Boolean);

const slug = urlList[urlList.length - 1] ?? "";
const pageUrl = `${SITE_URL}/insight/${slug}`;
const heroImageUrl = images[frontmatter.heroImage]?.default?.src
  ? new URL(images[frontmatter.heroImage].default.src, SITE_URL).toString()
  : undefined;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType="article"
  ogImage={heroImageUrl}
  author={frontmatter.author}
  publishedTime={frontmatter.pubDate.toISOString()}
  modifiedTime={frontmatter.pubDate.toISOString()}
  jsonLd={[
    breadcrumbLd([
      { name: "Home", url: SITE_URL + "/" },
      { name: "Insights", url: `${SITE_URL}/insight` },
      { name: frontmatter.title, url: pageUrl },
    ]),
    articleLd({
      slug,
      title: frontmatter.title,
      description: frontmatter.description,
      author: frontmatter.author,
      occupation: frontmatter.occupation,
      pubDate: frontmatter.pubDate.toISOString(),
      imageUrl: heroImageUrl,
      tags: frontmatter.tags,
    }),
  ]}
>
  <div class="mt-20 sm:mt-10 sm:pb-32 sm:pt-10">
    <Breadcrumbs urlList={urlList} isTitle={frontmatter.title} />
    <div class="sm:pb-30 mx-auto maxs-w-7xl px-6 pt-0 sm:px-2">
      <div class="container mx-auto px-0 sm:px-5 sm:pb-24">
        <!-- Blog Article -->
        <div class="sm:py-30 mx-auto max-w-7xl px-0 pt-0">
          <div class="grid gap-y-8 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-0">
            <!-- Content -->
            <div class="lg:col-span-2">
              <div class="py-8 lg:pr-8">
                <div class="space-y-5 lg:space-y-8">
                  <!-- Hero Image -->
                  <Image
                    src={images[frontmatter.heroImage]?.default}
                    alt={frontmatter.heroImageAlt}
                    class="rounded-xl"
                  />
                  <!-- Title -->
                  <h2 class="font-bold text-3xl lg:text-4xl leading-relaxed">
                    {frontmatter.title}
                  </h2>
                  <!-- Tag & Author & Date -->
                  <div class="flex items-center gap-x-5">
                    <!-- Date -->
                    <div class="flex items-center gap-2">
                      <Icon name="mdi:clock" class="text-sm" aria-hidden="true" />
                      <p class="text-[--color-text-offset] text-xs">
                        {frontmatter.pubDate.toLocaleDateString()}
                      </p>
                    </div>
                    <!-- Author -->
                    <div class="flex items-center gap-2">
                      <Icon name="mdi:account" class="text-sm" aria-hidden="true" />
                      <p class="text-[--color-text-offset] text-xs">
                        By {frontmatter.author}
                      </p>
                    </div>
                  </div>
                  <article
                    class="prose prose-blockquote:text-[--color-text-offset] prose-img:my-0"
                  >
                    <slot />
                  </article>
                  <!-- Article Footer -->
                  <div
                    class="grid gap-y-5 lg:flex lg:items-center lg:justify-between lg:gap-y-0"
                  >
                    <!-- Badges/Tags -->
                    <div class="flex items-center gap-3 text-[--color-text-offset]">
                      <Icon name="mdi:tag-outline" aria-hidden="true" />
                      <div class="flex flex-row flex-wrap gap-2">
                        {
                          frontmatter.tags.map((tag: string) => (
                            <a
                              class="badge items-center text-xs sm:text-sm"
                              href={`/insight/tags/${tag}`}
                            >
                              {tag}
                            </a>
                          ))
                        }
                      </div>
                    </div>
                    <!-- End Badges/Tags -->
                  </div>
                </div>
              </div>
            </div>
            <!-- End Content -->

            <!-- Sidebar -->
            <div
              class="bg-[--color-background-offset] lg:col-span-1 lg:h-full lg:w-full mt-8"
            >
              <div class="sticky-top left-0 top-0 p-2 sm:p-4 sm:py-4">
                <!-- Avatar Media -->
                <div
                  class="group mb-8 flex items-center gap-x-3 border-b border-gray-200 pb-8 dark:border-gray-700"
                >
                  <a class="block flex-shrink-0" href="/about" aria-label="About Greener-Dalii Studio">
                    <Icon name="logomark" class="text-3xl" aria-hidden="true" />
                  </a>

                  <a class="group block grow" href="/about">
                    <h5 class="font-semibold text-sm">
                      {frontmatter.author}
                    </h5>
                    <p class="text-xs">
                      {frontmatter.occupation}
                    </p>
                  </a>
                </div>
                <!-- End Avatar Media -->
                <!-- Read More -->
                <div class="pb-6 text-sm font-medium">Read More | 相关阅读</div>
                <div class="flex flex-col space-y-4">
                    {relatedPosts.map((post: any) => (
                      <div class="text-xs">
                        <a href={`/insight/${post.id}`}>▶︎ {post.data.title}</a>
                      </div>
                    ))}
                </div>
                <!-- End Read More -->
              </div>
            </div>
            <!-- End Sidebar -->
          </div>
        </div>
        <!-- End Blog Article -->
      </div>
    </div>
  </div>
  <!-- Citation block: explicit anchor so AI assistants and humans can cite this
       article unambiguously. schema.org/Citation metadata lives in the JSON-LD
       graph (Article entity above); this block is the on-page equivalent. -->
  <aside
    class="mx-auto max-w-7xl px-6 pb-16 text-xs text-[--color-text-offset]"
    aria-label="如何引用本文 | How to cite"
  >
    <details class="collapse collapse-arrow bg-[--color-background-offset]">
      <summary class="collapse-title font-medium cursor-pointer">
        引用本文 · How to cite this article
      </summary>
      <div class="collapse-content">
        <p class="leading-relaxed">
          {frontmatter.author} ({new Date(frontmatter.pubDate).getFullYear()}).
          <em>{frontmatter.title}</em>. Greener-Dalii Studio Insights.
          Retrieved from
          <a href={pageUrl} class="underline">{pageUrl}</a>.
        </p>
        <p class="pt-2 leading-relaxed">
          {frontmatter.author} ({new Date(frontmatter.pubDate).getFullYear()}).
          <em>{frontmatter.title}</em>. Greener-Dalii Studio.
          检索自
          <a href={pageUrl} class="underline">{pageUrl}</a>。
        </p>
      </div>
    </details>
  </aside>
</BaseLayout>
